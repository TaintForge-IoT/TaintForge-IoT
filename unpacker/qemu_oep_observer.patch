+/* Selected 32-bit guest map metadata, never host /proc mappings. */
+typedef struct {
+    uint64_t start, end;
+    uint64_t *records;
+    size_t count;
+} TfUserVmasV1;
+
+static int tf_user_vma_v1(void *opaque, vaddr start, vaddr end, int flags)
+{
+    TfUserVmasV1 *query = opaque;
+    uint64_t lo = MAX((uint64_t)start, query->start);
+    /* walk_memory_regions computes last + 1, which may wrap at UINT64_MAX. */
+    uint64_t hi = end ? MIN((uint64_t)end, query->end) : query->end;
+    uint64_t *record;
+
+    if (!(flags & PAGE_VALID) || lo >= hi) {
+        return 0;
+    }
+    if (query->count == 4096) {
+        return -ENOSPC;
+    }
+    if (query->records) {
+        record = query->records + 4 * query->count;
+        record[0] = lo;
+        record[1] = hi;
+        record[2] = (unsigned int)flags;
+        /* PAGE_WRITE can be cleared internally for self-modifying code. */
+        record[3] = (flags & (PAGE_READ | PAGE_EXEC)) |
+                    (flags & PAGE_WRITE_ORG ? PAGE_WRITE : 0);
+    }
+    query->count++;
+    return 0;
+}
+
+int qemu_plugin_taintforge_user_vmas_v1(uint64_t start, uint64_t end,
+                                       uint64_t *records, size_t capacity,
+                                       size_t *count, uint32_t *page_size)
+{
+    TfUserVmasV1 query = { .start = start, .end = end };
+    size_t page = qemu_target_page_size();
+    int rc;
+
+    if (count) {
+        *count = 0;
+    }
+    if (page_size) {
+        *page_size = 0;
+    }
+    if (!count || !page_size || !page || page > UINT32_MAX ||
+        (page & (page - 1)) || start >= end || end > (UINT64_C(1) << 32) ||
+        start % page || end % page || capacity > 4096 ||
+        (capacity && !records)) {
+        return -EINVAL;
+    }
+    /* The lock is recursive, including calls made from syscall callbacks. */
+    mmap_lock();
+    rc = walk_memory_regions(&query, tf_user_vma_v1);
+    if (rc == 0 && capacity && query.count > capacity) {
+        rc = -ENOSPC;
+    }
+    if (rc == 0 && capacity) {
+        query.records = records;
+        query.count = 0;
+        rc = walk_memory_regions(&query, tf_user_vma_v1);
+    }
+    mmap_unlock();
+    if (rc != 0) {
+        return rc == -ENOSPC ? -ENOSPC : -EIO;
+    }
+    *count = query.count;
+    *page_size = page;
+    return 0;
+}
