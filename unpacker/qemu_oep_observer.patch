+/**
+ * qemu_plugin_taintforge_user_vmas_v1() - bounded linux-user guest map snapshot
+ * @start: inclusive page-aligned guest address
+ * @end: exclusive page-aligned guest address, at most 2^32
+ * @records: caller buffer for four uint64_t values per mapped interval
+ * @capacity: interval capacity, at most 4096; zero performs a count-only query
+ * @count: number of returned intervals; zero on failure
+ * @page_size: guest target page size; zero on failure
+ *
+ * Custom TaintForge ABI v1, for vCPU execution or syscall callbacks after
+ * target initialization. Each interval is [start, end, raw page flags, RWX].
+ * Unmapped gaps are omitted; mapped PROT_NONE intervals are included. RWX uses
+ * bits 1/2/4; write is derived from PAGE_WRITE_ORG, not the SMC write-trap bit.
+ * The mmap lock keeps map metadata consistent across count/fill. This does not
+ * stop other vCPUs or provide an atomic RAM/register/process checkpoint.
+ *
+ * Returns 0, -EINVAL for invalid arguments, -ENOSPC for insufficient capacity,
+ * -EIO for a walk failure, or -ENOTSUP in system mode. Ignore buffer contents
+ * on failure. Count-only results are not bound to a later query.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_taintforge_user_vmas_v1(uint64_t start, uint64_t end,
+                                       uint64_t *records, size_t capacity,
+                                       size_t *count, uint32_t *page_size);
+
+/**
+ * qemu_plugin_taintforge_user_entry_v1() - bounded ELF table producer receipt
+ * @records: caller buffer for three uint64_t values per constructor word
+ * @capacity: record capacity, at most 1024; zero performs a count-only query
+ * @count: number of records returned; zero on failure
+ * @metadata: caller buffer for eight uint64_t metadata words
+ * @metadata_capacity: metadata buffer capacity in uint64_t words, at least eight
+ *
+ * Custom TaintForge ABI v1 for the initial static IA-32 Linux ELF entry. Each
+ * record is [guest address, written value, kind], in constructor write order;
+ * kind is 1 argc, 2 argv, 3 envp, or 4 auxv, including terminators. Metadata is
+ * [1, word_bytes, initial_sp, argc, envc, entry, phdr_address, has_interpreter].
+ * The receipt records values at loader writes, not by reading the later stack.
+ * It does not authenticate host launch inputs or establish a Linux kernel proof.
+ * Call only from the first original-entry vCPU callback; later calls return the
+ * same construction receipt and do not describe the current guest state.
+ *
+ * Returns 0, -EINVAL for invalid arguments, -ENOSPC for insufficient capacity,
+ * or -ENOTSUP before completion, on unsupported ELF/target, on a failed loader
+ * write or overflow, and in system mode. Ignore records on failure; count and
+ * the first eight metadata words (when provided) are cleared on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_taintforge_user_entry_v1(uint64_t *records, size_t capacity,
+                                        size_t *count, uint64_t *metadata,
+                                        size_t metadata_capacity);
+
+/**
+ * qemu_plugin_taintforge_user_brk_v1() - observe 32-bit linux-user brk state
+ * @initial: initial guest program break recorded by the ELF loader
+ * @current: current guest program break maintained by syscall emulation
+ *
+ * Custom TaintForge ABI v1. Use from a vCPU execution or syscall callback in
+ * the selected single-vCPU process. This observes emulator state without a
+ * guest syscall; it does not establish a process checkpoint or kernel proof.
+ * Returns 0, -EINVAL for null outputs, or -ENOTSUP outside 32-bit linux-user.
+ * Non-null outputs are zero on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_taintforge_user_brk_v1(uint64_t *initial, uint64_t *current);
+
