+int qemu_plugin_taintforge_user_brk_v1(uint64_t *initial, uint64_t *current)
+{
+    abi_ulong initial_brk, current_brk;
+
+    if (initial) {
+        *initial = 0;
+    }
+    if (current) {
+        *current = 0;
+    }
+    if (!initial || !current) {
+        return -EINVAL;
+    }
+    if (sizeof(abi_ulong) != 4) {
+        return -ENOTSUP;
+    }
+    target_brk_snapshot(&initial_brk, &current_brk);
+    *initial = initial_brk;
+    *current = current_brk;
+    return 0;
+}
