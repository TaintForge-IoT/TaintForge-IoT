+/* Bounded producer receipt for the selected static IA-32 entry table. */
+#define TF_USER_ENTRY_WORDS_V1 1024
+static struct {
+    uint64_t records[3 * TF_USER_ENTRY_WORDS_V1];
+    uint64_t metadata[8];
+    size_t count;
+    bool collecting, valid;
+} tf_user_entry_v1;
+
+static void tf_user_entry_begin_v1(abi_ulong sp, int argc, int envc,
+                                   abi_ulong entry, abi_ulong phdr,
+                                   unsigned word_bytes, bool interpreter,
+                                   bool supported)
+{
+    tf_user_entry_v1.count = 0;
+    tf_user_entry_v1.valid = false;
+    tf_user_entry_v1.collecting = supported && argc >= 0 && envc >= 0;
+    tf_user_entry_v1.metadata[0] = 1;
+    tf_user_entry_v1.metadata[1] = word_bytes;
+    tf_user_entry_v1.metadata[2] = sp;
+    tf_user_entry_v1.metadata[3] = argc;
+    tf_user_entry_v1.metadata[4] = envc;
+    tf_user_entry_v1.metadata[5] = entry;
+    tf_user_entry_v1.metadata[6] = phdr;
+    tf_user_entry_v1.metadata[7] = interpreter;
+}
+
+static void tf_user_entry_record_v1(abi_ulong value, abi_ulong address,
+                                    uint64_t kind, int rc)
+{
+    uint64_t *record;
+
+    if (!tf_user_entry_v1.collecting) {
+        return;
+    }
+    if (rc != 0 || tf_user_entry_v1.count == TF_USER_ENTRY_WORDS_V1) {
+        tf_user_entry_v1.collecting = false;
+        return;
+    }
+    record = tf_user_entry_v1.records + 3 * tf_user_entry_v1.count++;
+    record[0] = address;
+    record[1] = value;
+    record[2] = kind;
+}
+
+/* Preserve put_user_ual's lazy value evaluation on failed access checks. */
+#define tf_user_entry_put_v1(value, address, kind) do {                       \
+    abi_ulong tf_entry_address = (address);                                  \
+    abi_ulong tf_entry_value = 0;                                            \
+    int tf_entry_rc = put_user_ual((tf_entry_value = (value)),                \
+                                  tf_entry_address);                        \
+    tf_user_entry_record_v1(tf_entry_value, tf_entry_address,                 \
+                            (kind), tf_entry_rc);                            \
+} while (0)
+
+int qemu_plugin_taintforge_user_entry_v1(uint64_t *records, size_t capacity,
+                                        size_t *count, uint64_t *metadata,
+                                        size_t metadata_capacity)
+{
+    if (count) {
+        *count = 0;
+    }
+    if (metadata && metadata_capacity >= 8) {
+        memset(metadata, 0, 8 * sizeof(*metadata));
+    }
+    if (!count || !metadata || metadata_capacity < 8 ||
+        capacity > TF_USER_ENTRY_WORDS_V1 || (capacity && !records)) {
+        return -EINVAL;
+    }
+    if (!tf_user_entry_v1.valid) {
+        return -ENOTSUP;
+    }
+    if (capacity && capacity < tf_user_entry_v1.count) {
+        return -ENOSPC;
+    }
+    if (capacity) {
+        memcpy(records, tf_user_entry_v1.records,
+               3 * tf_user_entry_v1.count * sizeof(*records));
+    }
+    memcpy(metadata, tf_user_entry_v1.metadata, 8 * sizeof(*metadata));
+    *count = tf_user_entry_v1.count;
+    return 0;
+}
