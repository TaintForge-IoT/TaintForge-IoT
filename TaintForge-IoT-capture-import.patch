diff --git a/scripts/run_c2_replay_local_e2e.py b/scripts/run_c2_replay_local_e2e.py
new file mode 100644
index 0000000..625ca34
--- /dev/null
+++ b/scripts/run_c2_replay_local_e2e.py
@@ -0,0 +1,285 @@
+#!/usr/bin/env python3
+"""Exercise the real broker, import CLI, replay service and benign C client.
+
+Recording uses ephemeral loopback ports. Replay runs locally and validates a
+prepared synthesis iteration. --sandbox additionally executes that iteration
+through the privileged prebuilt runner on a Linux x86-64 development VM.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import platform
+import shutil
+import sys
+from pathlib import Path
+
+from taintforge_env.c2_record_broker import C2RecordBroker
+from taintforge_env.c2_record_policy import parse_c2_record_policy
+from taintforge_env.iteration_controller import IterationController
+from taintforge_env.network_policy import NetworkServicePolicy
+from taintforge_env.network_replay import TCPReplayService
+from taintforge_env.replay_store import ReplayStore, sha256_bytes
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+
+
+def check(condition: bool, message: str) -> None:
+    if not condition:
+        raise RuntimeError(message)
+
+
+async def command(*args: str, expected: int = 0, timeout: float = 30) -> bytes:
+    env = dict(os.environ, PYTHONPATH=str(PROJECT_ROOT), PYTHONDONTWRITEBYTECODE="1")
+    process = await asyncio.create_subprocess_exec(
+        *args, cwd=PROJECT_ROOT, env=env,
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
+    try:
+        stdout, stderr = await asyncio.wait_for(process.communicate(), timeout=timeout)
+    except BaseException:
+        if process.returncode is None:
+            process.kill()
+        await process.wait()
+        raise
+    check(process.returncode == expected,
+          f"command exited {process.returncode}, expected {expected}: {args!r}\n"
+          f"{stdout.decode(errors='replace')}{stderr.decode(errors='replace')}")
+    return stdout
+
+
+async def prepare_prebuilt(out: Path, client: Path, *, sandbox: bool) -> dict:
+    """Bind a real static test ELF and the imported store to the public runner."""
+    template = out / "template"
+    rootfs = template / "rootfs"
+    config = template / "config"
+    for name in ("bin", "proc", "tmp", "dev"):
+        (rootfs / name).mkdir(parents=True)
+    config.mkdir()
+    shutil.copy2(client, rootfs / "bin/unpacked.elf")
+    (config / "runtime.json").write_text(json.dumps({
+        "arch": "x86_64", "host_binary": str(client), "guest_binary": "/bin/unpacked.elf",
+        "qemu_required": False, "rootfs": str(rootfs),
+    }, indent=2) + "\n")
+    (config / "network_policy.json").write_text(json.dumps({
+        "mode": "replay", "allow_internet": False, "catch_all": {"enabled": False},
+        "services": [{"service_type": "tcp", "role": "c2", "remote_ip": "198.51.100.10",
+                      "remote_port": 48101, "domain": None, "bind_ip": "127.0.0.1",
+                      "bind_port": 48101, "protocol_hint": "c2_binary"}],
+    }, indent=2) + "\n")
+    session = out / "synthesis_session"
+    store = out / "replay_store"
+    log = await command(
+        sys.executable, str(PROJECT_ROOT / "scripts/run_synthesis_loop.py"), "run",
+        "--session-dir", str(session), "--template-run-dir", str(template),
+        "--project-root", str(PROJECT_ROOT), "--seed-rootfs", str(rootfs),
+        "--snapshot-store", str(out / "snapshots"), "--network", "replay",
+        "--replay-store", str(store), "--initialize-only")
+    (out / "synthesis_initialize.stdout").write_bytes(log)
+    binding = json.loads((session / "synthesis_loop.json").read_text())
+    check(binding["replay_store_sha256"] == ReplayStore(store).validate()["store_sha256"],
+          "synthesis binding does not match imported store")
+    IterationController(session).prepare_next()
+    runner_args = ("--session-dir", str(session), "--iteration", "0",
+                   "--template-run-dir", str(template), "--project-root", str(PROJECT_ROOT),
+                   "--network", "replay", "--replay-store", str(store), "--timeout", "15")
+    log = await command(sys.executable, str(PROJECT_ROOT / "scripts/run_prebuilt_iteration.py"),
+                        "validate", *runner_args)
+    (out / "prebuilt_validate.stdout").write_bytes(log)
+    if sandbox:
+        log = await command(sys.executable, str(PROJECT_ROOT / "scripts/run_prebuilt_iteration.py"),
+                            "run", *runner_args, timeout=90)
+        (out / "prebuilt_run.stdout").write_bytes(log)
+        run_dir = session / "iterations/0000/run"
+        execution = json.loads((run_dir / "config/prebuilt_execution.json").read_text())
+        check(execution["guest_exit_code"] == 0 and not execution["timed_out"],
+              "sandbox client failed or timed out")
+        check((run_dir / "logs/runtime_stdout.log").read_bytes() == b"world\n",
+              "sandbox replay output mismatch")
+        events = [json.loads(line) for path in (run_dir / "logs").rglob("network_events.jsonl")
+                  for line in path.read_text().splitlines()]
+        check(any(e.get("event") == "replay_hit" for e in events), "sandbox replay hit missing")
+        copied = ReplayStore(run_dir / "config/replay_store").validate()
+        check(copied["store_sha256"] == binding["replay_store_sha256"], "attempt store digest mismatch")
+    verification = json.loads(await command(
+        sys.executable, str(PROJECT_ROOT / "scripts/run_synthesis_loop.py"), "verify",
+        "--session-dir", str(session)))
+    check(verification["binding_verified"], "synthesis verification failed")
+    return {"prebuilt_validated": True, "synthesis_binding_verified": True,
+            "sandbox_executed": sandbox}
+
+
+async def run(out: Path, *, sandbox: bool = False) -> dict:
+    check(platform.system() == "Linux" and platform.machine() in ("x86_64", "amd64"),
+          "this static C-client scenario requires Linux x86-64")
+    out.mkdir(parents=True, exist_ok=False)
+    client = out / "c2_record_client"
+    await command("gcc", "-static", "-O2", "-Wall", "-Wextra", "-Werror",
+                  str(PROJECT_ROOT / "samples/c2_record_client.c"), "-o", str(client))
+    mock_done = asyncio.get_running_loop().create_future()
+    mock_connections = 0
+
+    async def mock(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+        nonlocal mock_connections
+        mock_connections += 1
+        try:
+            request = await asyncio.wait_for(reader.readexactly(5), 5)
+            check(request == b"hello", "mock received an unexpected request")
+            check(await asyncio.wait_for(reader.read(1), 5) == b"", "request has extra data")
+            # Deliberately split the response to exercise short recv() reads.
+            writer.write(b"wo")
+            await writer.drain()
+            # Wait for the broker to record the first chunk instead of assuming
+            # that a fixed delay always produces separate reads on a busy host.
+            async with asyncio.timeout(2):
+                while not list((out / "captures").glob(
+                        "*/chunks/000001_server_to_client.bin")):
+                    await asyncio.sleep(0.01)
+            writer.write(b"rld")
+            await writer.drain()
+        except Exception as exc:
+            if not mock_done.done():
+                mock_done.set_exception(exc)
+        else:
+            if not mock_done.done():
+                mock_done.set_result(None)
+        finally:
+            writer.close()
+            await writer.wait_closed()
+
+    upstream = await asyncio.start_server(mock, "127.0.0.1", 0)
+    upstream_port = int(upstream.sockets[0].getsockname()[1])
+    policy = parse_c2_record_policy({
+        "schema_version": 1, "mode": "brokered_record", "capture_kind": "local_test",
+        "default_action": "deny", "listen_port": 41000,
+        "target": {"original_ip": "198.51.100.10", "original_port": 48101,
+                   "upstream_ip": "127.0.0.1", "upstream_port": upstream_port},
+        "limits": {"max_connections": 1, "connect_timeout_seconds": 2,
+                   "session_timeout_seconds": 10, "idle_timeout_seconds": 2,
+                   "max_client_bytes": 1024, "max_server_bytes": 1024},
+    })
+    broker = C2RecordBroker(policy=policy, bind_ip="127.0.0.1", capture_root=out / "captures",
+                            run_id="local-c2-replay-e2e", listen_port_override=0)
+    try:
+        await broker.start()
+        recorded = await command(str(client), "127.0.0.1", str(broker.bound_port))
+        check(recorded == b"world\n", "record client output mismatch")
+        (out / "record_client.stdout").write_bytes(recorded)
+        await asyncio.wait_for(mock_done, 5)
+        async with asyncio.timeout(5):
+            while broker.active_sessions:
+                await asyncio.sleep(0.01)
+    finally:
+        await broker.close()
+        upstream.close()
+        await upstream.wait_closed()
+
+    # Prove the source responder is gone before starting replay.
+    try:
+        _, writer = await asyncio.wait_for(asyncio.open_connection("127.0.0.1", upstream_port), 2)
+    except ConnectionRefusedError:
+        pass
+    else:
+        writer.close()
+        await writer.wait_closed()
+        raise RuntimeError("upstream is still accepting connections")
+
+    sessions = list((out / "captures").glob("*/session.json"))
+    check(len(sessions) == 1, "expected exactly one captured session")
+    session_dir = sessions[0].parent
+    summary = json.loads(sessions[0].read_text())
+    check(summary["server_to_client"]["chunks"] >= 2, "split response was not captured")
+    store_path = out / "replay_store"
+    import_args = (sys.executable, str(PROJECT_ROOT / "scripts/replay_store.py"),
+                   "import-capture", "--session-dir", str(session_dir),
+                   "--store", str(store_path), "--protocol-hint", "c2_binary")
+    receipt = json.loads(await command(*import_args))
+    check(receipt["status"] == "imported", "first import did not create an entry")
+    (out / "import_receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
+    index_before = (store_path / "index.json").read_bytes()
+    second = json.loads(await command(*import_args))
+    check(second["status"] == "already_present" and second["entry_id"] == receipt["entry_id"],
+          "repeat import was not idempotent")
+    check((store_path / "index.json").read_bytes() == index_before, "repeat import modified index")
+    store = ReplayStore(store_path)
+    validation = store.validate()
+    service = TCPReplayService(
+        service=NetworkServicePolicy(service_type="tcp", role="c2",
+                                     remote_ip="198.51.100.10", remote_port=48101,
+                                     domain=None, bind_ip="127.0.0.1", bind_port=0,
+                                     protocol_hint="c2_binary"),
+        store=store, log_dir=out / "replay_logs")
+    replay = await service.start()
+    replay_port = int(replay.sockets[0].getsockname()[1])
+    try:
+        replayed = await command(str(client), "127.0.0.1", str(replay_port))
+        check(replayed == recorded, "offline replay differs from the recorded response")
+        (out / "replay_client.stdout").write_bytes(replayed)
+        reader, writer = await asyncio.open_connection("127.0.0.1", replay_port)
+        try:
+            writer.write(b"unknown")
+            await writer.drain()
+            check(await asyncio.wait_for(reader.read(), 2) == b"", "replay miss returned data")
+        finally:
+            writer.close()
+            await writer.wait_closed()
+    finally:
+        replay.close()
+        await replay.wait_closed()
+
+    events = [json.loads(line) for line in
+              (out / "replay_logs/network_events.jsonl").read_text().splitlines()]
+    hits = [event for event in events if event["event"] == "replay_hit"]
+    misses = [event for event in events if event["event"] == "replay_miss"]
+    check(len(hits) == 1 and hits[0]["entry_id"] == receipt["entry_id"], "missing exact replay hit")
+    check(len(misses) == 1, "missing replay miss evidence")
+    check(mock_connections == 1, "unexpected upstream traffic")
+
+    damaged = out / "damaged_capture"
+    shutil.copytree(session_dir, damaged)
+    chunk = next((damaged / "chunks").glob("*_server_to_client.bin"))
+    chunk.write_bytes(b"corrupted")
+    rejected = await command(
+        sys.executable, str(PROJECT_ROOT / "scripts/replay_store.py"), "import-capture",
+        "--session-dir", str(damaged), "--store", str(store_path),
+        "--protocol-hint", "c2_binary", expected=1)
+    (out / "corrupt_import.stdout").write_bytes(rejected)
+    check((store_path / "index.json").read_bytes() == index_before, "failed import modified index")
+    check(store.validate() == validation, "replay store changed during validation/replay")
+
+    prebuilt = await prepare_prebuilt(out, client, sandbox=sandbox)
+    report = {
+        "status": "passed", "scope": "loopback record/import/replay and prebuilt validation",
+        "record_exit_code": 0, "replay_exit_code": 0,
+        "response_sha256": sha256_bytes(b"world"),
+        "upstream_stopped_before_replay": True, "upstream_connections": mock_connections,
+        "response_capture_chunks": summary["server_to_client"]["chunks"],
+        "entry_id": receipt["entry_id"], "replay_hits": len(hits), "replay_misses": len(misses),
+        "repeat_import": second["status"], "corrupt_capture_rejected": True,
+        "store_sha256": validation["store_sha256"],
+        **prebuilt,
+    }
+    (out / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True, help="New output directory; never overwritten")
+    parser.add_argument("--sandbox", action="store_true",
+                        help="Also execute the prepared replay iteration on a privileged development VM")
+    args = parser.parse_args()
+    os.umask(0o077)
+    try:
+        report = asyncio.run(run(args.out.absolute(), sandbox=args.sandbox))
+    except (OSError, RuntimeError, TimeoutError) as exc:
+        print(f"C2 record/import/replay failed: {exc}", file=sys.stderr)
+        return 1
+    print(json.dumps(report, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/taintforge_env/capture_importer.py b/taintforge_env/capture_importer.py
new file mode 100644
index 0000000..e95a892
--- /dev/null
+++ b/taintforge_env/capture_importer.py
@@ -0,0 +1,343 @@
+"""Import one completed C2RecordBroker TCP transaction without guessing framing.
+
+This is an offline, single-writer operation. Validate an archived session before
+publishing its exchange through ReplayStore's atomic index update. TCP packet and
+recv boundaries are not message boundaries: consecutive chunks in each direction
+are joined, but server-first and interleaved conversations are rejected.
+"""
+from __future__ import annotations
+
+import ipaddress
+import json
+import math
+import os
+import stat
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from .replay_store import (
+    DEFAULT_MAX_REQUEST_BYTES,
+    DEFAULT_MAX_RESPONSE_BYTES,
+    ReplayEntry,
+    ReplayEntryExistsError,
+    ReplayStore,
+    ReplayStoreValidationError,
+    normalize_protocol_hint,
+    sha256_bytes,
+)
+
+
+MAX_SESSION_BYTES = 64 * 1024
+MAX_EVENTS_BYTES = 8 * 1024 * 1024
+MAX_EVENTS = 16384
+MAX_CHUNK_BYTES = 65536
+DIRECTIONS = ("client_to_server", "server_to_client")
+CLEAN_CLOSE_REASONS = ("upstream_closed", "client_closed", "completed")
+
+
+class CaptureImportError(ReplayStoreValidationError):
+    pass
+
+
+@dataclass(frozen=True)
+class CaptureTransaction:
+    remote_ip: str
+    remote_port: int
+    request_bytes: bytes
+    response_bytes: bytes
+    provenance: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class CaptureImportResult:
+    entry: ReplayEntry
+    created: bool
+    provenance: dict[str, Any]
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "status": "imported" if self.created else "already_present",
+            "entry_id": self.entry.entry_id,
+            "source": self.provenance,
+        }
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise CaptureImportError(message)
+
+
+def _integer(value: Any, label: str, minimum: int, maximum: int) -> int:
+    _require(type(value) is int and minimum <= value <= maximum,
+             f"{label} must be an integer in [{minimum}, {maximum}]")
+    return value
+
+
+def _number(value: Any, label: str) -> float:
+    _require(type(value) in (int, float), f"{label} must be a number")
+    try:
+        result = float(value)
+    except OverflowError as exc:
+        raise CaptureImportError(f"{label} is too large") from exc
+    _require(math.isfinite(result) and result >= 0,
+             f"{label} must be a finite non-negative number")
+    return result
+
+
+def _string(value: Any, label: str) -> str:
+    _require(isinstance(value, str) and bool(value.strip()) and len(value) <= 256,
+             f"{label} must be a non-empty string of at most 256 characters")
+    return value
+
+
+def _object(value: Any, label: str) -> dict[str, Any]:
+    _require(isinstance(value, dict), f"{label} must be an object")
+    return value
+
+
+def _json_object(data: bytes, label: str) -> dict[str, Any]:
+    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key, value in items:
+            _require(key not in result, f"{label}: duplicate JSON key {key!r}")
+            result[key] = value
+        return result
+
+    def invalid_constant(value: str) -> None:
+        raise CaptureImportError(f"{label}: invalid JSON constant {value}")
+
+    try:
+        value = json.loads(data, object_pairs_hook=pairs,
+                           parse_constant=invalid_constant)
+    except (ValueError, UnicodeError, RecursionError) as exc:
+        raise CaptureImportError(f"{label}: invalid JSON: {exc}") from exc
+    return _object(value, label)
+
+
+def _no_symlinks(path: Path) -> None:
+    for component in (path, *path.absolute().parents):
+        _require(not component.is_symlink(),
+                 f"capture path must not contain a symlink: {component}")
+
+
+def _read_file(path: Path, limit: int) -> bytes:
+    _no_symlinks(path)
+    # O_NONBLOCK avoids hanging on a FIFO before fstat can reject it.
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(fd, "rb") as handle:
+            metadata = os.fstat(handle.fileno())
+            _require(stat.S_ISREG(metadata.st_mode),
+                     f"capture file must be regular: {path}")
+            _require(metadata.st_size <= limit, f"capture file exceeds limit: {path}")
+            data = handle.read(limit + 1)
+            _require(len(data) <= limit, f"capture file exceeds limit: {path}")
+            return data
+    except OSError as exc:
+        raise CaptureImportError(f"cannot read capture file {path}: {exc}") from exc
+
+
+def _check_digest(data: bytes, expected: Any, label: str) -> None:
+    _require(isinstance(expected, str) and sha256_bytes(data) == expected,
+             f"{label}: SHA-256 mismatch")
+
+
+def _timestamp(value: Any, label: str) -> datetime:
+    try:
+        parsed = datetime.fromisoformat(_string(value, label))
+    except ValueError as exc:
+        raise CaptureImportError(f"{label}: invalid timestamp") from exc
+    _require(parsed.utcoffset() is not None, f"{label}: timezone is required")
+    return parsed
+
+
+def load_capture_transaction(
+    session_dir: str | Path,
+    *,
+    max_request_bytes: int = DEFAULT_MAX_REQUEST_BYTES,
+    max_response_bytes: int = DEFAULT_MAX_RESPONSE_BYTES,
+) -> CaptureTransaction:
+    """Verify broker schema v1, completion, ordering, and every payload byte."""
+    root = Path(session_dir)
+    _no_symlinks(root)
+    summary_bytes = _read_file(root / "session.json", MAX_SESSION_BYTES)
+    summary = _json_object(summary_bytes, "session.json")
+    _integer(summary.get("schema_version"), "schema_version", 1, 1)
+    run_id = _string(summary.get("run_id"), "run_id")
+    session_id = _string(summary.get("session_id"), "session_id")
+    _require(summary.get("capture_kind") in ("local_test", "live"),
+             "unsupported capture_kind")
+    _require(summary.get("transport", "tcp") == "tcp", "only TCP is supported")
+    _require(summary.get("close_reason") in CLEAN_CLOSE_REASONS,
+             "capture did not close cleanly (timeout, error, or incomplete session)")
+    _require("error" in summary and summary["error"] is None,
+             "capture contains an error")
+    started = _timestamp(summary.get("started_at_utc"), "started_at_utc")
+    finished = _timestamp(summary.get("finished_at_utc"), "finished_at_utc")
+    _require(finished >= started, "session finishes before it starts")
+    duration = _number(summary.get("duration_seconds"), "duration_seconds")
+    try:
+        remote_ip = str(ipaddress.IPv4Address(
+            _string(summary.get("original_remote_ip"), "original_remote_ip")))
+        ipaddress.ip_address(_string(summary.get("upstream_ip"), "upstream_ip"))
+    except ValueError as exc:
+        raise CaptureImportError("invalid endpoint; replay requires original IPv4") from exc
+    remote_port = _integer(summary.get("original_remote_port"),
+                           "original_remote_port", 1, 65535)
+    _integer(summary.get("upstream_port"), "upstream_port", 1, 65535)
+
+    limits = _object(summary.get("limits"), "limits")
+    payloads: dict[str, bytes] = {}
+    stream_metadata: dict[str, dict[str, Any]] = {}
+    source_files = {
+        "session.json": sha256_bytes(summary_bytes),
+    }
+    for direction, maximum, limit_key in (
+        (DIRECTIONS[0], min(max_request_bytes, DEFAULT_MAX_REQUEST_BYTES), "max_client_bytes"),
+        (DIRECTIONS[1], min(max_response_bytes, DEFAULT_MAX_RESPONSE_BYTES), "max_server_bytes"),
+    ):
+        metadata = _object(summary.get(direction), direction)
+        expected_path = f"{direction}.bin"
+        _require(metadata.get("path") == expected_path,
+                 f"{direction}: non-canonical payload path")
+        size = _integer(metadata.get("bytes"), f"{direction}.bytes", 1, maximum)
+        limit = _integer(limits.get(limit_key), limit_key, 1, DEFAULT_MAX_RESPONSE_BYTES)
+        _require(size <= limit, f"{direction}: recorded byte limit exceeded")
+        _integer(metadata.get("chunks"), f"{direction}.chunks", 1, MAX_EVENTS)
+        payload = _read_file(root / expected_path, maximum)
+        _require(len(payload) == size, f"{direction}: size mismatch")
+        _check_digest(payload, metadata.get("sha256"), direction)
+        payloads[direction] = payload
+        stream_metadata[direction] = metadata
+        source_files[expected_path] = sha256_bytes(payload)
+
+    events_bytes = _read_file(root / "events.jsonl", MAX_EVENTS_BYTES)
+    _require(events_bytes.endswith(b"\n"), "events.jsonl is truncated")
+    lines = events_bytes.splitlines()
+    _require(5 <= len(lines) <= MAX_EVENTS, "events.jsonl: invalid event count")
+    events = [_json_object(line, f"events.jsonl:{i}") for i, line in enumerate(lines, 1)]
+    _require(events[0].get("event") == "session_started", "missing session_started")
+    _require(events[1].get("event") == "upstream_connected", "missing upstream_connected")
+    _require(events[-1].get("event") == "session_finished", "missing session_finished")
+    for key in ("original_remote_ip", "original_remote_port", "upstream_ip",
+                "upstream_port", "capture_kind"):
+        _require(type(events[0].get(key)) is type(summary[key])
+                 and events[0][key] == summary[key], f"session_started: {key} mismatch")
+    for key in ("upstream_ip", "upstream_port"):
+        _require(type(events[1].get(key)) is type(summary[key])
+                 and events[1][key] == summary[key], f"upstream_connected: {key} mismatch")
+    final = events[-1]
+    _require(final.get("close_reason") == summary["close_reason"]
+             and "error" in final and final["error"] is None,
+             "session_finished disagrees with summary")
+    for key, direction in (("client_bytes", DIRECTIONS[0]), ("server_bytes", DIRECTIONS[1])):
+        size = _integer(final.get(key), f"session_finished.{key}", 1, DEFAULT_MAX_RESPONSE_BYTES)
+        _require(size == len(payloads[direction]), f"session_finished: {key} mismatch")
+    for event in events:
+        _require(event.get("session_id") == session_id, "event session_id mismatch")
+        _timestamp(event.get("timestamp_utc"), "event.timestamp_utc")
+
+    offsets = dict.fromkeys(DIRECTIONS, 0)
+    counts = dict.fromkeys(DIRECTIONS, 0)
+    eof: set[str] = set()
+    chunk_names: set[str] = set()
+    response_started = False
+    last_elapsed = 0.0
+    for event in events[2:-1]:
+        kind = event.get("event")
+        _require(kind in ("stream_chunk", "stream_eof"), f"unexpected capture event: {kind}")
+        direction = event.get("direction")
+        _require(direction in DIRECTIONS, "invalid stream direction")
+        _require(direction not in eof, f"{direction}: data or duplicate EOF after EOF")
+        if kind == "stream_eof":
+            eof.add(direction)
+            continue
+        if direction == DIRECTIONS[0]:
+            _require(not response_started, "interleaved/multi-round capture is unsupported")
+        else:
+            _require(offsets[DIRECTIONS[0]] > 0, "server-first capture is unsupported")
+            response_started = True
+        index = _integer(event.get("chunk_index"), "chunk_index", 1, MAX_EVENTS)
+        _require(index == counts[direction] + 1, "missing or reordered chunk index")
+        size = _integer(event.get("size"), "chunk.size", 1, MAX_CHUNK_BYTES)
+        elapsed = _number(event.get("elapsed_seconds"), "elapsed_seconds")
+        _require(last_elapsed <= elapsed <= duration, "chunk elapsed time is out of order/range")
+        last_elapsed = elapsed
+        name = f"{index:06d}_{direction}.bin"
+        _require(event.get("payload_file") == f"chunks/{name}", "non-canonical chunk path")
+        chunk = _read_file(root / "chunks" / name, MAX_CHUNK_BYTES)
+        _require(len(chunk) == size, "chunk size mismatch")
+        _check_digest(chunk, event.get("sha256"), name)
+        offset = offsets[direction]
+        _require(payloads[direction][offset:offset + size] == chunk,
+                 f"{direction}: chunks disagree with aggregate stream")
+        offsets[direction] += size
+        counts[direction] += 1
+        chunk_names.add(name)
+    _require(DIRECTIONS[1] in eof, "response is incomplete: missing upstream EOF")
+    for direction in DIRECTIONS:
+        _require(offsets[direction] == len(payloads[direction])
+                 and counts[direction] == stream_metadata[direction]["chunks"],
+                 f"{direction}: missing chunks or count mismatch")
+    _no_symlinks(root / "chunks")
+    with os.scandir(root / "chunks") as entries:
+        for item in entries:
+            _require(item.name in chunk_names, f"unreferenced capture chunk: {item.name}")
+    source_files["events.jsonl"] = sha256_bytes(events_bytes)
+    provenance = {
+        "schema_version": 1,
+        "importer": "c2-capture-single-transaction-v1",
+        "run_id": run_id,
+        "session_id": session_id,
+        "capture_kind": summary["capture_kind"],
+        "source_files_sha256": source_files,
+        "close_reason": summary["close_reason"],
+        "replay_policy": {"close_after_send": True, "delay_ms": 0},
+    }
+    return CaptureTransaction(remote_ip, remote_port, payloads[DIRECTIONS[0]],
+                              payloads[DIRECTIONS[1]], provenance)
+
+
+def import_capture(
+    session_dir: str | Path,
+    store: ReplayStore,
+    *,
+    protocol_hint: str | None = None,
+) -> CaptureImportResult:
+    """Validate first; identical imports are no-ops and conflicting ones fail.
+
+    Provenance uses the existing notes/source_run_id fields, so ReplayStore v1
+    remains compatible. A repeated import returns its own source receipt while
+    retaining the existing entry's original attribution. No concurrent writers.
+    """
+    capture = load_capture_transaction(
+        session_dir, max_request_bytes=store.max_request_bytes,
+        max_response_bytes=store.max_response_bytes)
+    hint = normalize_protocol_hint(protocol_hint)
+    # Do not initialize (or modify) a store until all validation has succeeded.
+    if store.root.exists() or store.root.is_symlink():
+        store.validate()
+        exchanges = store.exchanges_for_endpoint(
+            transport="tcp", remote_ip=capture.remote_ip,
+            remote_port=capture.remote_port, protocol_hint=hint)
+        for exchange in exchanges:
+            if exchange.request_bytes == capture.request_bytes:
+                response = exchange.entry.response
+                if (exchange.response_bytes != capture.response_bytes
+                        or not response.close_after_send or response.delay_ms != 0):
+                    raise ReplayEntryExistsError(
+                        f"capture conflicts with existing response/policy: {exchange.entry.entry_id}")
+                return CaptureImportResult(exchange.entry, False, capture.provenance)
+            if (exchange.request_bytes.startswith(capture.request_bytes)
+                    or capture.request_bytes.startswith(exchange.request_bytes)):
+                raise CaptureImportError("capture would introduce TCP request prefix ambiguity")
+    entry = store.add(
+        transport="tcp", remote_ip=capture.remote_ip, remote_port=capture.remote_port,
+        request_bytes=capture.request_bytes, response_bytes=capture.response_bytes,
+        protocol_hint=hint, close_after_send=True, delay_ms=0,
+        source_run_id=capture.provenance["run_id"],
+        notes=json.dumps({"capture_import": capture.provenance}, sort_keys=True),
+    )
+    return CaptureImportResult(entry, True, capture.provenance)
